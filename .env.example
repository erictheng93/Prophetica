# SPEC-017 §7.1 — local development .env template.
# `make bootstrap` first-run copies this file to `.env` if it does not exist.
# Production secrets MUST come from Vault sidecar (SPEC-010 §3.3); never commit
# real credentials to this file.

# --- Application ---
APP_ENV=local
PROPHETICA_ENV=dev
RUST_LOG=info

# --- Datastores ---
DATABASE_URL=postgres://proph:dev@localhost:5432/prophetica
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# --- Secrets management ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
# Dev/test may leave these empty; staging/production must provide real secrets.
SUMSUB_WEBHOOK_SECRET=
KYC_DOCUMENT_HASH_SALT=

# --- Observability (OpenTelemetry → Tempo / Loki / Prometheus / Grafana) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TEMPO_OTLP_GRPC_PORT=4317
LOKI_PORT=3100
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Backend service ports (SPEC-014 §4) ---
API_GATEWAY_PORT=8080
WS_GATEWAY_PORT=8083
USER_SERVICE_PORT=8084
KYC_SERVICE_PORT=8085
WALLET_LEDGER_SERVICE_PORT=8086
MARKET_SERVICE_PORT=8087
MATCHING_ENGINE_PORT=8088
POSITION_SERVICE_PORT=8089
SETTLEMENT_WORKER_PORT=8090
RISK_ANTIFRAUD_SERVICE_PORT=8091
REFERRAL_SERVICE_PORT=8092
NOTIFICATION_SERVICE_PORT=8093
ANALYTICS_REPORTING_SERVICE_PORT=8094

# --- Local mocks (tools/mocks/*) ---
MOCK_SUMSUB_PORT=8081
MOCK_PAYMENT_PORT=8082

# --- SPEC-020 analytics reporting real API wiring ---
# Admin BFF signs with ADMIN_INTERNAL_CALL_SECRET; api-gateway verifies with
# INTERNAL_CALL_HMAC_SECRET. Local dev values must match.
API_GATEWAY_URL=http://localhost:8080
ANALYTICS_REPORTING_SERVICE_URL=http://localhost:8094
KYC_SERVICE_URL=http://localhost:8085
LEDGER_SERVICE_URL=http://localhost:8086
RISK_SERVICE_URL=http://localhost:8091
USER_SERVICE_URL=http://localhost:8084
ADMIN_INTERNAL_CALL_SECRET=dev-analytics-internal-call-secret
INTERNAL_CALL_HMAC_SECRET=dev-analytics-internal-call-secret

# --- Frontend (apps/web, apps/admin, apps/liff) ---
WEB_PORT=3000
ADMIN_PORT=3010
LIFF_PORT=3020
# Optional: official LINE add-friend URL used by the web signup beta gate.
NEXT_PUBLIC_OFFICIAL_LINE_URL=

# --- LIFF (LINE mini app) ---
# Required for apps/liff; missing value → page renders "MissingLiffIdScreen".
# Production value is provisioned by the LINE Developer Console and stored in
# Cloudflare Pages env binding (SPEC-014 §3.2.1 場景 E).
NEXT_PUBLIC_LIFF_ID=

# --- @cloudflare/kumo ---
# v0.2.3 erratum (2026-05-05): Kumo is published on the public npm registry;
# no auth token required. Do not reintroduce KUMO_NPM_TOKEN.
