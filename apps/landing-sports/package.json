{
  "name": "@prophetica/landing-sports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "prophetica sports landing variant (SPEC-021).",
  "prophetica": {
    "variant": {
      "id": "sports",
      "regions": [
        "TW",
        "JP",
        "KR",
        "VN",
        "MY",
        "PH"
      ],
      "product_lines": [
        "sports"
      ],
      "design_theme": "apple",
      "deployment": {
        "domain": "sports.prophetica.example",
        "path_prefix": "/"
      },
      "owner": "marketing",
      "launched_at": "2026-06-01",
      "retired_at": null
    }
  },
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "tsc --project tsconfig.lint.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "latest",
    "@opennextjs/cloudflare": "^1.19.9",
    "@phosphor-icons/react": "^2.1.7",
    "@prophetica/design-tokens": "workspace:*",
    "@prophetica/ts-sdk": "workspace:*",
    "@prophetica/ui": "workspace:*",
    "next": "^16.2.6",
    "next-intl": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "wrangler": "^4.90.0"
  }
}
