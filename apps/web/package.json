{
  "name": "@prophetica/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "prophetica player-facing web app bootstrap.",
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "tsc --project tsconfig.lint.json",
    "test": "node -e \"require('node:fs').rmSync('.test-out', { recursive: true, force: true })\" && tsc --project tsconfig.test.json && node --experimental-strip-types --disable-warning=ExperimentalWarning --test .test-out/tests/*.test.js"
  },
  "dependencies": {
    "@cloudflare/kumo": "latest",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.19.9",
    "@phosphor-icons/react": "^2.1.7",
    "@prophetica/design-tokens": "workspace:*",
    "@prophetica/ts-sdk": "workspace:*",
    "@prophetica/ui": "workspace:*",
    "lightweight-charts": "^5.2.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.90.0"
  }
}
